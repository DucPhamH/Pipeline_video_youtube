# Dev (npm run dev): trỏ thẳng API local.
VITE_API_BASE_URL=http://localhost:8090
# Translate-service local (uvicorn :8010 — tránh đụng port 8001). Docker/nginx: để trống.
VITE_TRANSLATE_API_BASE_URL=http://localhost:8010
# TTS local (uvicorn :8011). Docker/nginx: để trống.
VITE_TTS_API_BASE_URL=http://localhost:8011
# Write local (uvicorn :8012). Docker/nginx: để trống.
VITE_WRITE_API_BASE_URL=http://localhost:8012
# AI local (uvicorn :8013). Docker/nginx: để trống.
VITE_AI_API_BASE_URL=http://localhost:8013

# Docker production build: để trống (cùng origin, nginx proxy /api).
# VITE_API_BASE_URL=
# VITE_TRANSLATE_API_BASE_URL=
# VITE_TTS_API_BASE_URL=
# VITE_WRITE_API_BASE_URL=
# VITE_AI_API_BASE_URL=
