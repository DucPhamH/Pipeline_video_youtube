# Copy sang .env. Để trống = SQLite tại tts-service/data/db.sqlite3
DATABASE_URL=

# CORS cho React (port khác). Bỏ comment nếu cần ghi đè default trong code.
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Thư mục file mp3. Trống = tts-service/data/audio
AUDIO_DIR=

# Dịch vụ AI, dùng khi nhận diện nhân vật. Trống = http://127.0.0.1:8013
AI_API_BASE_URL=

# Token dùng chung giữa các service. Đặt thì mọi route trừ /api/health cần header
# X-Folio-Token (hoặc Authorization: Bearer, hoặc ?token= với GET cho <audio src>/tải file).
# Trống = không kiểm tra, chỉ cảnh báo lúc khởi động. Gọi translate-service cũng gửi kèm.
FOLIO_API_TOKEN=

# Giới hạn file TXT / EPUB tải lên (MB). Trống = 50.
TTS_MAX_UPLOAD_MB=
