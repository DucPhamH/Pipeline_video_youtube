# Copy sang .env và điền giá trị thật.

# Để trống = dùng SQLite mặc định tại backend/data/db.sqlite3
DATABASE_URL=

# License self-host (xem docs/platform-and-licensing.md)
LICENSE_KEY=

# --- Proxy (ưu tiên UI Settings; env chỉ fallback) ---
# Cách dùng khuyến nghị (giống lncrawl):
#   1. Cài đặt chung → Proxy VN = http://127.0.0.1:7890
#   2. Hoặc trang site → Cài đặt quét → Proxy URL (ghi đè từng site)
#
# Env dưới đây chỉ dùng khi UI để trống:
# CRAWL_HTTP_PROXY=socks5h://127.0.0.1:1080
# CRAWL_PROXY_FILE=/path/to/proxies.txt
# CRAWL_PROXY_VN=http://127.0.0.1:7890
# CRAWL_PROXY_JP=
# CRAWL_PROXY_KR=
# CRAWL_PROXY_TW=
# CRAWL_PROXY_CN=
#
# Fallback chuẩn hệ thống nếu CRAWL_* trống: ALL_PROXY / HTTPS_PROXY / HTTP_PROXY

# --- Translate handoff (P2) ---
# TRANSLATE_SERVICE_URL=http://localhost:8010
# CRAWL_PUBLIC_URL=http://localhost:8090

# --- Lịch quét hàng ngày ---
# Múi giờ so giờ hẹn của từng site (IANA). Để trống = giờ local của tiến trình
# (theo biến TZ của OS; container Docker mặc định là UTC).
# SCHEDULER_TZ=Asia/Ho_Chi_Minh

# --- Bảo mật ---
# Token dùng chung giữa các service. Đặt thì mọi route (trừ /api/health,
# /docs) đòi header `X-Folio-Token: <token>` hoặc `Authorization: Bearer
# <token>`; GET tải file nhận thêm `?token=`. Gọi sang translate-service cũng
# gửi header này; callback translate-lifecycle cũng phải có token.
# Để trống = không kiểm tra (log cảnh báo lúc khởi động).
# FOLIO_API_TOKEN=
#
# Nguồn demo_local (đọc file trong data/fixtures) — chỉ bật cho test/dev.
# CRAWL_ENABLE_DEMO_SOURCE=false
# Cho phép fetch tới IP private/loopback (site test nội bộ). Mặc định chặn (SSRF).
# CRAWL_ALLOW_PRIVATE_FETCH=false
# Cho phép webhook thông báo trỏ tới IP private (vd n8n nội bộ).
# NOTIFY_ALLOW_PRIVATE_WEBHOOK=false
