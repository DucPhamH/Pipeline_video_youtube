# Copy sang .env và điền giá trị thật.

# Để trống = dùng SQLite mặc định tại translate-service/data/db.sqlite3
DATABASE_URL=

# CORS cho React FE (port khác)
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Crawl URL để fallback lifecycle callback
CRAWL_SERVICE_URL=http://localhost:8090

# Token dùng chung (tùy chọn). Đặt thì mọi API trừ health cần header
# X-Folio-Token (hoặc Authorization: Bearer). Để trống = không kiểm tra.
FOLIO_API_TOKEN=

# Nhà AI (khóa). Trống = bảng local của dịch. Dev/compose: http://127.0.0.1:8013
# Docker Compose ghi đè thành http://ai-service:8000
AI_API_BASE_URL=

# Giới hạn upload EPUB/TXT (MB) và dung lượng EPUB sau giải nén (MB)
TRANSLATE_MAX_UPLOAD_MB=50
TRANSLATE_MAX_EPUB_UNCOMPRESSED_MB=500
